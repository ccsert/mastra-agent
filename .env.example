# Prefer pnpm setup:local to create random local secrets without overwriting existing files.
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://agent_platform:replace-with-random-password@127.0.0.1:5442/agent_platform
ENCRYPTION_KEY=replace-with-64-hex-characters
RUNTIME_TOKEN=replace-with-random-service-token
RUNTIME_ID=hosted-local
CONTROL_PLANE_URL=http://127.0.0.1:4110
CONSOLE_ORIGIN=http://127.0.0.1:5179
CONSOLE_HOST=0.0.0.0
# pnpm dev/preview authorize this machine's live IPv4 console addresses, including network changes.
# Additional exact origins for custom entrances, comma-separated (no wildcard).
# CONSOLE_ADDITIONAL_ORIGINS=http://192.168.1.100:5179
CONSOLE_PORT=5179
API_PORT=4110
RUNTIME_PORT=4112
# COOKIE_SECURE=true requires HTTPS; use in a TLS deployment.
